{
    "name": "cv_catalog",
    "version": "0.0.1",
    "private": true,
    "description": "",
    "license": "UNLICENSED",
    "author": "",
    "type": "module",
    "scripts": {
        "build": "nest build",
        "db:generate": "prisma generate",
        "db:make_migrations": "prisma migrate dev --create-only",
        "db:migrate_dev": "prisma migrate dev",
        "db:migrate_deploy": "prisma migrate deploy",
        "prebuild": "npm run db:generate",
        "format": "oxfmt --write \"src/**/*.ts\" \"test/**/*.ts\"",
        "start": "nest start",
        "start:dev": "nest start --watch",
        "start:debug": "nest start --debug --watch",
        "start:prod": "node dist/main.js",
        "lint": "oxlint src/ test/",
        "lint:fix": "oxlint src/ test/ --fix",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:cov": "vitest run --coverage",
        "test:debug": "vitest --inspect-brk --no-file-parallelism",
        "test:e2e": "vitest run --config ./vitest.config.e2e.ts"
    },
    "dependencies": {
        "@apollo/server": "^5.5.1",
        "@as-integrations/express5": "^1.1.2",
        "@nestjs/apollo": "^14.0.1",
        "@nestjs/common": "^12.0.1",
        "@nestjs/config": "^12.0.0",
        "@nestjs/core": "^12.0.1",
        "@nestjs/graphql": "^14.0.1",
        "@nestjs/platform-express": "^12.0.1",
        "@prisma/adapter-pg": "^7.10.0",
        "@prisma/client": "^7.10.0",
        "@strv/nestjs-dataloader": "^0.4.2",
        "class-transformer": "^0.5.1",
        "graphql": "^16.14.2",
        "pg": "^8.23.0",
        "reflect-metadata": "^0.2.2",
        "rxjs": "^7.8.1",
        "zod": "^4.6.5"
    },
    "devDependencies": {
        "@nestjs/cli": "^12.0.0",
        "@nestjs/mau": "^0.2.6",
        "@nestjs/schematics": "^12.0.0",
        "@nestjs/testing": "^12.0.1",
        "@swc/cli": "^0.8.1",
        "@swc/core": "^1.16.2",
        "@types/express": "^5.0.0",
        "@types/node": "^24.0.0",
        "@types/supertest": "^7.0.0",
        "@vitest/coverage-v8": "^4.1.2",
        "oxfmt": "^0.68.0",
        "oxlint": "^1.58.0",
        "oxlint-tsgolint": "^7.0.2002",
        "prisma": "^7.10.0",
        "source-map-support": "^0.5.21",
        "supertest": "^7.0.0",
        "typescript": "^6.0.2",
        "vite-tsconfig-paths": "^5.1.4",
        "vitest": "^4.1.2"
    }
}
